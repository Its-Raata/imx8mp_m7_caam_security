From: Raata <its.raata@gmail.com>
Date: Sat, 3 Oct 2026 15:30:00 +0330
Subject: [PATCH] imx8mp: mcu_rdc grant CAAM to M7 domain 1

Path B: M7 owns CAAM. Fix RDC_PDAP_CAAM for i.MX8MP (58, not 114),
assign CAAM master to DID1, and PDAP domain-1-only on bootaux.
Restore DID0 + D0/D1 PDAP on MCU stop.

Signed-off-by: Raata <its.raata@gmail.com>
---

--- a/arch/arm/dts/imx8mp-sec-def.h
+++ b/arch/arm/dts/imx8mp-sec-def.h
@@ -144,7 +144,7 @@
 #define RDC_PDAP_ASRC  107
 #define RDC_PDAP_SDMA3  109
 #define RDC_PDAP_SPBA1  111
-#define RDC_PDAP_CAAM  114
+#define RDC_PDAP_CAAM  58   /* i.MX8MP: ATF/MCUX; 114 is 8MN/MM */
 
 /* RDC MEMORY REGION */
 #define TCM_START 0x7E0000

--- a/arch/arm/dts/imx8mp-evk-u-boot.dtsi
+++ b/arch/arm/dts/imx8mp-evk-u-boot.dtsi
@@ -26,6 +26,9 @@
 			     *   GPT1   --> Only Domian 1 can access
 			     *   SDMA3  --> Only Domian 1 can access
 			     *   I2C3   --> Only Domian 1 can access
+			     *   CAAM   --> Only Domain 1 (M7) can access (Path B)
+			     * master:
+			     *   CAAM   --> Domain 1 (DMA into M7 reserved DDR)
 			     * memory:
 			     *   TCM    --> Only Domian 1 can access (0x7E0000~0x81FFFF)
 			     *   DDR    --> Only Domian 1 can access (0x80000000~0x81000000)
@@ -43,6 +46,8 @@
 			    RDC_PDAP RDC_PDAP_GPT1  PDAP_D1_ACCESS 0x0 0x0
 			    RDC_PDAP RDC_PDAP_SDMA3 PDAP_D1_ACCESS 0x0 0x0
 			    RDC_PDAP RDC_PDAP_I2C3  PDAP_D1_ACCESS 0x0 0x0
+			    RDC_MDA  RDC_MDA_CAAM DID1 0x0 0x0
+			    RDC_PDAP RDC_PDAP_CAAM PDAP_D1_ACCESS 0x0 0x0
 			    RDC_MEM_REGION 22 TCM_START TCM_END MEM_D1_ACCESS
 			    RDC_MEM_REGION 39 M4_DDR_START M4_DDR_END MEM_D1_ACCESS
 			    0x0      0x0            0x0  0x0 0x0
@@ -54,6 +59,8 @@
 			     * end.
 			     */
 		stop-config = <
+			    RDC_MDA  RDC_MDA_CAAM DID0 0x0 0x0
+			    RDC_PDAP RDC_PDAP_CAAM PDAP_D0D1_ACCESS 0x0 0x0
 			    RDC_MEM_REGION 22 TCM_START TCM_END MEM_D0D1_ACCESS
 			    RDC_MEM_REGION 39 M4_DDR_START M4_DDR_END MEM_D0D1_ACCESS
 			    0x0      0x0            0x0  0x0 0x0
